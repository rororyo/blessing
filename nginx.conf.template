server {
    listen ${PORT};
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types
        text/plain text/css text/javascript application/javascript application/json
        application/wasm application/octet-stream image/svg+xml font/ttf font/otf;

    # Sent with YouTube embeds: the embedded player needs to see an origin.
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Content-Type-Options "nosniff" always;

    # Flutter web does not put content hashes in file names, so anything that can
    # change between deploys must be revalidated (ETag, cheap 304s) or users could
    # get a mix of old and new files after a redeploy.
    location ~* ^/(index\.html|flutter_bootstrap\.js|flutter\.js|flutter_service_worker\.js|version\.json|manifest\.json|main\.dart\.(js|mjs|wasm))$ {
        add_header Cache-Control "no-cache" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # CanvasKit is large; revalidate so an engine upgrade can never be mismatched.
    location /canvaskit/ {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Fonts, images and icons change rarely.
    location ~* ^/(assets|icons)/ {
        add_header Cache-Control "public, max-age=86400" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Single page app: every other path (deep links, refresh) gets index.html.
    location / {
        add_header Cache-Control "no-cache" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri $uri/ /index.html;
    }
}
